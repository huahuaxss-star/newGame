[
  { "id": "music_box", "text": "河马发现一个神秘的音乐盒，打开后那低沉的音乐让他睡了一整晚。", "npcText": "——村民说，那是大师在闭关冥想。", "exp": 8, "effects": [{ "icon": "hp", "label": "最大生命-4%", "stat": "maxHpPct", "v": -0.04 }] },
  { "id": "free_bun", "text": "路边摊掉了个包子，河马顺势吃了。摊主以为他在帮忙试毒。", "exp": 10, "effects": [{ "icon": "hp", "label": "回血", "stat": "hp", "v": 60 }] },
  { "id": "good_nap", "text": "河马在草垛上睡了个好觉，醒来神清气爽（指更胖了）。", "exp": 12, "effects": [{ "icon": "hp", "label": "最大生命+6%", "stat": "maxHpPct", "v": 0.06 }] },
  { "id": "carry_crate", "text": "河马被误认为搬运工，扛了一上午货。意外练出了力气。", "npcText": "——‘那位大师在以劳修心。’", "exp": 14, "effects": [{ "icon": "atk", "label": "攻击+5", "stat": "atk", "v": 5 }] },
  { "id": "shiny_shield", "text": "河马把一口锅盖顶在头上挡太阳，居然挺结实。", "exp": 8, "effects": [{ "icon": "def", "label": "防御+3", "stat": "def", "v": 3 }] },
  { "id": "festival", "text": "镇上在办节庆，河马排错队领了一堆吃的。", "exp": 16, "effects": [{ "icon": "hp", "label": "回满", "stat": "hp", "v": 9999 }] },
  { "id": "rain", "text": "突然下雨，河马没找到屋檐，淋了个透。打了个喷嚏。", "exp": 6, "effects": [{ "icon": "def", "label": "防御-2", "stat": "def", "v": -2 }] },
  { "id": "elf_gift", "text": "河马在山洞里挪开块石头找面包，顺手放出了被困的精灵。精灵感激地塞给他一件宝贝。", "npcText": "——‘解救了被封印的古灵！’", "exp": 18, "effects": [{ "icon": "hp", "label": "最大生命+7%", "stat": "maxHpPct", "v": 0.07 }] },
  { "id": "lost_sign", "text": "河马看不懂路牌，原地转了三圈。围观群众以为他在堪舆风水。", "exp": 10, "effects": [] },
  { "id": "goddess", "text": "森林女神回应了河马（其实他只是在打呼噜），赐予了祝福。", "exp": 20, "effects": [{ "icon": "atk", "label": "攻击+4", "stat": "atk", "v": 4 }] },

  { "id": "stew", "text": "路边一锅来历不明的炖菜，冒着可疑的泡。", "npcText": "——河马面无表情地盯着它。",
